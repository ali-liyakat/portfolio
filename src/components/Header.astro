---
const links = [
  { href: "/research", label: "Research" },
  { href: "/publications", label: "Publications" },
  { href: "/projects", label: "Projects" },
  { href: "/experience", label: "Experience" },
  { href: "/contact", label: "Contact" },
];
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4">
    <a href="/" class="font-serif text-lg font-semibold text-ink">Liyakat Ali Joo</a>
    <nav class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
      {links.map((l) => (
        <a href={l.href} class="hover:text-accent">{l.label}</a>
      ))}
    </nav>
  </div>
</header>