---
import { site } from "../data/site";
import Section from "./Section.astro";

const labels: Record<string, string> = {
  linkedin: "LinkedIn",
  github: "GitHub",
  kaggle: "Kaggle",
  scholar: "Google Scholar",
  orcid: "ORCID",
};

const order = ["linkedin", "github", "kaggle", "scholar", "orcid"];
const links = site.links as Record<string, string | undefined>;

const profiles = order
  .filter((key) => links[key])
  .map((key) => ({ label: labels[key], url: links[key] as string }));
---

<Section id="contact" tone="navy">
  <div class="grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-center">
    <div>
      <h2 class="text-3xl font-semibold text-white sm:text-4xl">Let’s connect</h2>
      <p class="mt-4 max-w-lg text-lg leading-relaxed text-white/80">
        I’m open to AI engineering roles, research collaborations and new projects. Send me a
        note, and I’ll share a CV.
      </p>

      <a
        href={`mailto:${site.email}`}
        class="mt-8 inline-block rounded-md bg-white px-6 py-3 text-sm font-semibold text-accent transition hover:bg-accent-soft"
      >
        {site.email}
      </a>
      <p class="mt-4 text-sm text-white/60">Based in {site.location}</p>
    </div>

    <ul class="grid gap-3">
      {profiles.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl border border-white/20 px-5 py-4 text-white transition hover:bg-white/10"
          >
            <span class="font-medium">{p.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Section>