---
import { education } from "../data/education";
import Section from "./Section.astro";

const palette = [
  "bg-sky-100 text-sky-800",
  "bg-emerald-100 text-emerald-800",
  "bg-amber-100 text-amber-800",
  "bg-violet-100 text-violet-800",
  "bg-rose-100 text-rose-800",
  "bg-teal-100 text-teal-800",
];

const bars = ["bg-accent", "bg-teal-600"];

const linkClass =
  "underline decoration-accent/30 underline-offset-4 transition hover:text-accent hover:decoration-accent";
---

<Section id="education" tone="paper">
  <h2 class="text-3xl font-semibold">Education</h2>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {education.map((e, idx) => (
      <article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-sm">
        <div class={`h-1.5 ${bars[idx % bars.length]}`}></div>

        <div class="flex flex-1 flex-col p-6">
          <h3 class="text-xl font-semibold leading-snug">{e.degree}</h3>

          <p class="mt-1 font-medium text-accent">
            {e.institutionUrl ? (
              <a href={e.institutionUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
                {e.institution}
              </a>
            ) : (
              e.institution
            )}
          </p>
          <p class="text-sm text-muted">{e.location}</p>

          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded-full bg-accent px-3 py-1 text-xs font-medium text-white">{e.period}</span>
            <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800">{e.grade}</span>
          </div>

          <div class="mt-5 rounded-lg bg-accent-soft/60 p-3 text-sm leading-relaxed">
            <span class="font-semibold text-accent">{e.highlight.label}: </span>
            {e.highlight.url ? (
              <a href={e.highlight.url} target="_blank" rel="noopener noreferrer" class={`${linkClass} text-ink/80`}>
                {e.highlight.text} ↗
              </a>
            ) : (
              <span class="text-ink/80">{e.highlight.text}</span>
            )}
            {e.advisor && (
              <p class="mt-1 text-muted">
                Advisor:{" "}
                {e.advisorUrl ? (
                  <a href={e.advisorUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    {e.advisor}
                  </a>
                ) : (
                  e.advisor
                )}
              </p>
            )}
          </div>

          <ul class="mt-4 space-y-1.5 text-sm text-muted">
            {e.honours.map((h) => (
              <li class="flex gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
                {h}
              </li>
            ))}
          </ul>

          <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-muted">Key coursework</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {e.courses.map((c, i) => (
              <li class={`rounded-lg px-3 py-1.5 text-xs font-semibold ${palette[i % palette.length]}`}>{c}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</Section>