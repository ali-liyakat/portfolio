---
import { researchStatement, interests, publications, researchProjects } from "../data/research";
import Section from "./Section.astro";

const palette = [
  "bg-sky-100 text-sky-800",
  "bg-emerald-100 text-emerald-800",
  "bg-amber-100 text-amber-800",
  "bg-violet-100 text-violet-800",
  "bg-rose-100 text-rose-800",
  "bg-teal-100 text-teal-800",
];

const pubLinkLabels: Record<string, string> = { paper: "Paper", pdf: "PDF", code: "Code" };
const projectLinkLabels: Record<string, string> = {
  thesis: "Thesis",
  paper: "Paper",
  code: "Code",
  award: "Award",
};

const linkClass =
  "text-accent underline decoration-accent/30 underline-offset-4 transition hover:decoration-accent";

const isMe = (name: string) => name.startsWith("Liyakat Ali");
const linksOf = (links?: Record<string, string | undefined>) =>
  Object.entries(links ?? {}).filter(([, url]) => url);
---

<Section id="research" tone="paper">
  <h2 class="text-3xl font-semibold">Research</h2>
  <p class="mt-3 max-w-2xl text-muted">{researchStatement}</p>

  <ul class="mt-5 flex flex-wrap gap-2">
    {interests.map((item, i) => (
      <li class={`rounded-lg px-3 py-1.5 text-xs font-semibold ${palette[i % palette.length]}`}>{item}</li>
    ))}
  </ul>

  <!-- Publications -->
  <h3 class="mt-14 text-xl font-semibold">Publications</h3>
  <ol class="mt-4 divide-y divide-line border-y border-line">
    {publications.map((p) => {
      const links = linksOf(p.links);
      return (
        <li class="grid gap-2 py-6 md:grid-cols-[5rem_1fr] md:gap-6">
          <p class="font-serif text-2xl font-semibold text-accent">{p.year}</p>
          <div>
            <h4 class="font-serif text-lg font-semibold leading-snug">{p.title}</h4>
            <p class="mt-1.5 text-sm text-muted">
              {p.authors.map((a, i) => (
                <Fragment>
                  <span class:list={[isMe(a) && "font-semibold text-ink"]}>{a}</span>
                  {i < p.authors.length - 1 && ", "}
                </Fragment>
              ))}
            </p>
            <p class="mt-1 text-sm italic text-muted">{p.venue}</p>
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium">
              <span class="rounded-full bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent">{p.type}</span>
              {links.map(([key, url]) => (
                <a href={url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {pubLinkLabels[key]} ↗
                </a>
              ))}
            </div>
          </div>
        </li>
      );
    })}
  </ol>

  <!-- Research projects -->
  <h3 class="mt-14 text-xl font-semibold">Research projects</h3>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    {researchProjects.map((r) => {
      const links = linksOf(r.links);
      return (
        <article
          class:list={[
            "flex flex-col rounded-2xl border border-line bg-white p-6 shadow-sm",
            r.wide && "md:col-span-2",
          ]}
        >
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-violet-100 px-2.5 py-1 text-xs font-semibold text-violet-800">{r.label}</span>
            <span class="rounded-full bg-accent px-2.5 py-1 text-xs font-medium text-white">{r.period}</span>
          </div>

          <h4 class="mt-3 font-serif text-xl font-semibold leading-snug">{r.title}</h4>
          {r.shortName && <p class="mt-1 font-medium text-accent">{r.shortName}</p>}
          {r.meta && <p class="mt-1 text-sm text-muted">{r.meta}</p>}
            {r.award && (
            <p class="mt-3 self-start rounded-lg bg-amber-100 px-3 py-1.5 text-xs font-semibold text-amber-800">
              ★ {r.award}
            </p>
          )}

          <p class:list={["mt-4 leading-relaxed text-muted", r.wide && "md:max-w-3xl"]}>{r.description}</p>

          {r.kpis && (
            <div
              class:list={[
                "mt-4 grid auto-cols-fr grid-flow-col gap-3 rounded-xl bg-accent-soft/70 p-4",
                r.wide && "md:max-w-md",
              ]}
            >
              {r.kpis.map((k) => (
                <div>
                  <p class="font-serif text-3xl font-semibold leading-none text-accent">{k.value}</p>
                  <p class="mt-1.5 text-xs font-medium text-muted">{k.label}</p>
                </div>
              ))}
            </div>
          )}
          {r.note && <p class="mt-2 text-xs text-muted">{r.note}</p>}

          {r.caseStudy && (
            <div class="mt-6 rounded-xl border border-accent/20 bg-accent-soft/40 p-5">
              <p class="text-xs font-semibold uppercase tracking-wide text-accent">Case study within the thesis</p>
              <h5 class="mt-1 font-serif text-lg font-semibold">{r.caseStudy.title}</h5>
              <p class="mt-2 text-sm leading-relaxed text-muted md:max-w-3xl">{r.caseStudy.description}</p>
              <div class="mt-4 grid auto-cols-fr grid-flow-col gap-3 rounded-lg bg-white p-4 md:max-w-md">
                {r.caseStudy.kpis.map((k) => (
                  <div>
                    <p class="font-serif text-2xl font-semibold leading-none text-accent">{k.value}</p>
                    <p class="mt-1.5 text-xs font-medium text-muted">{k.label}</p>
                  </div>
                ))}
              </div>
              {r.caseStudy.note && <p class="mt-2 text-xs text-muted">{r.caseStudy.note}</p>}
            </div>
          )}

          {r.skills.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {r.skills.map((skill, i) => (
                <li class={`rounded-lg px-3 py-1.5 text-xs font-semibold ${palette[i % palette.length]}`}>{skill}</li>
              ))}
            </ul>
          )}

          {links.length > 0 && (
            <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6 text-sm font-medium">
              {links.map(([key, url]) => (
                <a href={url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {projectLinkLabels[key]} ↗
                </a>
              ))}
            </div>
          )}
        </article>
      );
    })}
  </div>
</Section>