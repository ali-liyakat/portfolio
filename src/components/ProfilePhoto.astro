---
import { site } from "../data/site";

const parts = site.name.split(" ");
const initials = parts[0][0] + parts[parts.length - 1][0];
---

<div class="relative mx-auto w-40 sm:w-52 md:w-64">
  <div class="absolute inset-0 translate-x-2 translate-y-2 rounded-2xl bg-accent-soft"></div>
  {
    site.photo ? (
      <img
        src={site.photo}
        alt={`Portrait of ${site.name}`}
        width="512"
        height="512"
        fetchpriority="high"
        class="relative aspect-square w-full rounded-2xl object-cover"
      />
    ) : (
      <div class="relative flex aspect-square w-full items-center justify-center rounded-2xl border border-line bg-white font-serif text-5xl text-accent">
        {initials}
      </div>
    )
  }
</div>