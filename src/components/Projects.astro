---
import { featuredProjects, moreProjects } from "../data/projects";
import { site } from "../data/site";
import Section from "./Section.astro";

const palette = [
  "bg-sky-100 text-sky-800",
  "bg-emerald-100 text-emerald-800",
  "bg-amber-100 text-amber-800",
  "bg-violet-100 text-violet-800",
  "bg-rose-100 text-rose-800",
  "bg-teal-100 text-teal-800",
];

const categoryStyles: Record<string, string> = {
  Research: "bg-violet-100 text-violet-800",
  "Generative AI": "bg-sky-100 text-sky-800",
  "Computer Vision": "bg-emerald-100 text-emerald-800",
  "Machine Learning": "bg-amber-100 text-amber-800",
};

const linkLabels: Record<string, string> = {
  github: "GitHub",
  demo: "Live demo",
  paper: "Paper",
};

const linkClass =
  "text-accent underline decoration-accent/30 underline-offset-4 transition hover:decoration-accent";
---

<Section id="projects" tone="band">
  <h2 class="text-3xl font-semibold">Projects</h2>
  <p class="mt-3 max-w-2xl text-muted">
    Applied AI and software projects, each with the result that mattered.
  </p>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {featuredProjects.map((p) => {
      const links = Object.entries(p.links ?? {}).filter(([, url]) => url);
      return (
        <article
          class:list={[
            "flex flex-col rounded-2xl border border-line bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md",
            p.flagship && "md:col-span-2",
          ]}
        >
          <div class="flex flex-wrap items-center gap-2">
            <span class={`rounded-full px-2.5 py-1 text-xs font-semibold ${categoryStyles[p.category]}`}>
              {p.category}
            </span>
            {p.flagship && (
              <span class="rounded-full bg-accent px-2.5 py-1 text-xs font-medium text-white">Flagship</span>
            )}
          </div>

          <h3 class="mt-3 text-xl font-semibold">{p.name}</h3>

          <div
            class:list={[
                "mt-4 grid auto-cols-fr grid-flow-col gap-3 rounded-xl bg-accent-soft/70 p-4",
              p.flagship && "md:max-w-md",
            ]}
          >
            {p.kpis.map((k) => (
              <div>
                <p class="font-serif text-3xl font-semibold leading-none text-accent">{k.value}</p>
                <p class="mt-1.5 text-xs font-medium text-muted">{k.label}</p>
              </div>
            ))}
          </div>
          {p.note && <p class="mt-2 text-xs text-muted">{p.note}</p>}

          <p class:list={["mt-4 leading-relaxed text-muted", p.flagship && "md:max-w-3xl"]}>
            {p.description}
          </p>

          <ul class="mt-5 flex flex-wrap gap-2">
            {p.skills.map((skill, i) => (
              <li class={`rounded-lg px-3 py-1.5 text-xs font-semibold ${palette[i % palette.length]}`}>
                {skill}
              </li>
            ))}
          </ul>

          {links.length > 0 && (
            <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6 text-sm font-medium">
              {links.map(([key, url]) => (
                <a href={url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {linkLabels[key]} ↗
                </a>
              ))}
            </div>
          )}
        </article>
      );
    })}
  </div>

    <div class="mt-16">
    <h3 class="text-xl font-semibold">More projects</h3>

    <ul class="mt-6 grid gap-6 md:grid-cols-2">
      {moreProjects.map((m, i) => (
        <li class="flex flex-col items-start gap-2">
          {m.url ? (
            <a
              href={m.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`rounded-lg px-3.5 py-2 text-sm font-semibold transition hover:-translate-y-0.5 hover:shadow-sm ${palette[i % palette.length]}`}
            >
              {m.name} ↗
            </a>
          ) : (
            <span class={`rounded-lg px-3.5 py-2 text-sm font-semibold ${palette[i % palette.length]}`}>
              {m.name}
            </span>
          )}
          <p class="text-sm leading-relaxed text-muted">{m.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</Section>