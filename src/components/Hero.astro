---
import { site } from "../data/site";
import ProfilePhoto from "./ProfilePhoto.astro";
import Section from "./Section.astro";

const words = site.tagline.split(" ");
// Delay between words (seconds). Shrinks automatically for long taglines.
const step = Math.min(0.22, 1.8 / Math.max(words.length - 1, 1));
// Gradient colours, left to right across the whole tagline. Swap these to change the look.
const stops = ["#1e3a8a", "#4f46e5", "#0891b2"];

const hexToRgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const colorAt = (t: number) => {
  const seg = Math.min(Math.floor(t * (stops.length - 1)), stops.length - 2);
  const local = t * (stops.length - 1) - seg;
  const a = hexToRgb(stops[seg]);
  const b = hexToRgb(stops[seg + 1]);
  const c = a.map((v, i) => Math.round(v + (b[i] - v) * local));
  return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
};
const gradients = words.map(
  (_, i) => `linear-gradient(90deg, ${colorAt(i / words.length)}, ${colorAt((i + 1) / words.length)})`
);

const social = [
  { label: "GitHub", href: site.links.github, external: true },
  { label: "LinkedIn", href: site.links.linkedin, external: true },
  { label: "Email", href: `mailto:${site.email}`, external: false },
];
---

<Section id="home" tone="paper" innerClass="py-14 md:py-24">
  <div class="grid items-center gap-10 md:grid-cols-[1fr_auto] md:gap-14">
    <div class="order-2 md:order-1">
      <p class="mb-4 inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
        {site.role}
      </p>

      <h1 class="text-4xl font-semibold leading-tight sm:text-5xl">
        <span class="sr-only">{site.tagline}</span>
        <span aria-hidden="true">
          {words.map((word, i) => (
            <span
              class="tagline-word"
              style={`animation-delay: ${(i * step).toFixed(2)}s; background-image: ${gradients[i]}`}
            >{word}</span>
          ))}
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{site.intro}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        {social.map((s) => (
          <a
            href={s.href}
            class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-white transition hover:opacity-85"
            {...(s.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {s.label}
          </a>
        ))}
      </div>
    </div>

    <div class="order-1 md:order-2">
      <ProfilePhoto />
    </div>
  </div>
</Section>

<style is:global>
  .tagline-word {
    display: inline-block;
    margin-right: 0.25em;
    opacity: 0;
    /* 12s = one full loop. Make it longer for a longer pause, shorter for a faster loop. */
    animation: tagline-glide 12s cubic-bezier(0.22, 1, 0.36, 1) infinite both;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #1f3a5f;
  }

  @keyframes tagline-glide {
    0% {
      opacity: 0;
      transform: translateX(-32px);
      filter: blur(4px);
    }
    6% {
      opacity: 1;
      transform: translateX(0);
      filter: blur(0);
    }
    76% {
      opacity: 1;
      transform: translateX(0);
      filter: blur(0);
    }
    82%,
    100% {
      opacity: 0;
      transform: translateX(0);
      filter: blur(0);
    }
  }

  /* Visitors who prefer reduced motion: a single gentle fade, no sliding or looping. */
  @media (prefers-reduced-motion: reduce) {
    .tagline-word {
      animation: tagline-fade 0.8s ease both;
    }
    @keyframes tagline-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }
</style>